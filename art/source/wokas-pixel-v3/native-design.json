    "frontTarget": { "minimumWidth": 17, "maximumWidth": 30, "minimumHeight": 28, "maximumHeight": 30 },
    "feetBaseline": 30
  },
  "badge": { "x": 11, "y": 18, "size": 9, "glyphX": 12, "glyphY": 19, "fill": "#fff3d4" },
  "style": "Chibi RPG proportions (head about 16px wide, 16 rows; body 14 rows), selective hue-shifted dark outlines per material, four-tone ramps lit from the top left, two-pixel eyes with a highlight, belted coat in the sign colour, trousers and boots, legs that alternate in stride frames, real side profiles and back-of-head views.",
  "requirements": [
    "24 human characters: 12 signs, male and female",
    "Sign glyph on a 9x9 parchment chest badge in every DOWN frame, 7x7 one-pixel glyph",
    "Sign accessory recognisable in DOWN, LEFT, RIGHT and UP",
    "Three distinct poses per direction; feet on row 30; transparent one-pixel border",
    "Same 96x128 sheet contract as v2; texture IDs unchanged"
  ],
